    "keywords": ["pseudonymization", "anonymization", "Czech", "GDPR", "privacy", "data protection", "personal data", "data security"],
    "location": "Brno, Czech Republic",
    "authentication": "no",
    "output": ["application/json"],
    "inputs": [{
        "id": "text",
        "mediatypes": ["text/plain"],
        "languages": ["ces"],
        "maxSize": 4096
    }],
    "webApplication": {
        "url": "https://nlp.fi.muni.cz/projekty/pseudonymizer/index.py",
        "queryParameters": [
            {
                "name": "output",
                "value": "json"
